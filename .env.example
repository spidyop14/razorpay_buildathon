# Server-only Google Gemini LLM configuration. Never place this key in NEXT_PUBLIC variables.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional legacy AI configuration
# AI_API_KEY=
# AI_MODEL=

# Razorpay Test Mode only. Keep both server-side; never use NEXT_PUBLIC_ for the secret.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
